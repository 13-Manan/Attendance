# Copy to .env (root, used by docker-compose and Prisma CLI) and to apps/web/.env.local
# (used by the Next.js app at runtime). Never commit real secrets.

# --- Database (apps/web, Prisma) ---
# Matches the postgres service in docker-compose.yml
DATABASE_URL="postgresql://attendance:attendance@localhost:5432/attendance?schema=public"

# --- Face AI service contract (apps/web -> services/face-ai) ---
# Internal-only URL, never exposed to the browser or the public API.
FACE_AI_SERVICE_URL="http://localhost:8000"

# Shared secret apps/web presents to face-ai as `Authorization: Bearer <token>`.
# Must equal FACE_AI_AUTH_TOKEN below. Leave both empty for a local checkout;
# set both in any environment that will hold real faces.
#   openssl rand -base64 32
FACE_AI_SERVICE_TOKEN=""

# --- Local AI for offline attendance (apps/web) ---
# Opt-in, and OFF by default. Set to "true" only when FACE_AI_SERVICE_URL points
# at an inference node on the institution's own machine or LAN — one that stays
# reachable from the classroom when the internet does not.
#
# It is a human statement, not something the app detects: a cloud deployment and
# an on-premises one look identical from inside the process, and claiming "local
# AI" on a cloud host would be a lie told to a teacher with no signal. Even when
# this is "true", /api/local-ai/health still has to get a live answer with a
# loaded model before the UI says AVAILABLE. Offline attendance works either
# way — without it the teacher marks the roster by hand.
LOCAL_AI_ENABLED="false"

# --- Auth (apps/web) ---
# Symmetric secret used to sign session cookies / tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# --- Public integration API (apps/web) ---
# Pepper mixed into API key hashing before storage (ApiKey.hashedKey).
API_KEY_PEPPER="replace-with-a-generated-secret"

# --- Face AI service (services/face-ai) ---
# Selects the EmbeddingModel implementation from the model registry.
# "mock" is the only implementation provided in this foundation phase.
FACE_MODEL_BACKEND="mock"

# The other half of FACE_AI_SERVICE_TOKEN above — the value face-ai accepts.
# Empty means the service accepts anonymous callers and says so in a warning on
# every boot. That is the development mode, and it is a real exposure: anybody
# who can reach the port can turn a photograph into a biometric template via
# POST /v1/enroll, with no database and no session involved. Set it wherever
# real faces are processed.
FACE_AI_AUTH_TOKEN=""

# Turns "warn about an empty token" into "refuse to start". Set it to "true" in
# staging and production, so an environment that loses its token fails loudly at
# boot rather than quietly serving biometric inference to anyone. Same shape as
# FACE_AI_REQUIRE_PRODUCTION_MODEL, which already refuses to start on the mock
# backend.
FACE_AI_REQUIRE_AUTH="false"
