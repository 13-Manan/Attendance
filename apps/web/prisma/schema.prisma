// Foundation-phase schema. Core models only — proves the school/college
// abstraction and the AI-advisory / faculty-authoritative attendance model.
// See docs/DATA_MODEL.md for the full narrative and docs/adr/0003 for the
// multi-tenancy rationale.
//
// NOTE on pgvector: Prisma has no native vector scalar type. FaceEmbedding.embedding
// is declared with Unsupported("vector(128)") below, which means:
//   - `prisma generate` will NOT produce a typed field for it on the Prisma Client.
//   - `CREATE EXTENSION vector` must be added by hand to the generated migration SQL.
//     It is done, at the top of migrations/20260917000000_init/migration.sql.
//   - Any read of the column must go through `prisma.$queryRaw`. Today every such
//     read is cohort- or subject-scoped and casts to text; see
//     modules/recognition-results/repository.ts.
//   - No ANN (HNSW/IVFFlat) index exists, deliberately. Nothing in this codebase
//     uses the `<=>` operator, so an ANN index would have no reader and would only
//     add write cost. docs/BENCHMARKS.md §4 records the measurement behind that
//     choice and docs/DATABASE_OPERATIONS.md carries the exact statement to add if
//     a future phase adopts `<=>` pre-filtering.
//
// NOTE on RBAC (Phase 2): `Role` rows with institutionId = null are platform-wide
// system roles. Postgres does not treat two NULLs as equal in a unique index, so
// `@@unique([institutionId, key])` below does NOT stop two platform-wide roles
// sharing a key. The fix is a partial unique index, hand-patched into the same
// baseline migration (same category of fix as the pgvector note above):
//   CREATE UNIQUE INDEX role_key_platform_unique ON "Role"(key) WHERE "institutionId" IS NULL;
// Prisma cannot express it, so `prisma migrate diff` will never regenerate it —
// it must be carried forward by hand if the baseline is ever rebuilt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum InstitutionType {
  SCHOOL
  COLLEGE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// Discriminates the AcademicUnit tree so one schema serves both a school's
// Grade -> Section hierarchy and a college's Department -> Semester -> Course
// hierarchy without forking tables. See docs/MULTI_TENANCY.md.
enum AcademicUnitKind {
  DEPARTMENT
  GRADE
  SEMESTER
  COURSE
  SECTION
  GENERIC
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  COMPLETED
}

enum SessionStatus {
  OPEN
  CAPTURING
  PROCESSING
  REVIEW
  FINALIZED
  CANCELLED
}

enum AttendanceResult {
  PRESENT
  ABSENT
  NEEDS_REVIEW
  NOT_EVALUATED
}

enum CorrectionSource {
  FACULTY_REVIEW
  ROLL_CALL
  ADMIN_OVERRIDE
  PUBLIC_API
}

enum CohortFacultyRole {
  PRIMARY
  ASSISTANT
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Institution {
  id           String          @id @default(cuid())
  name         String
  type         InstitutionType
  timezone     String          @default("UTC")
  // Contact details for the institution itself — the address a report is
  // headed with and the number a parent rings. Columns rather than keys in
  // `settings` because they are profile facts about the tenant, not knobs
  // that change how the software behaves: everything in `settings` alters
  // product behaviour, and mixing the two makes it impossible to say which
  // changes are safe. All nullable: an institution created before this
  // existed is not incomplete, it simply has not filled them in.
  contactEmail String?
  contactPhone String?
  addressLine  String?
  // e.g. { academicUnitLabels: { grade: "Grade", section: "Section" },
  //        confidenceThresholds: { presentMin: 0.62, reviewMin: 0.45 },
  //        attendanceMode: "DAILY" | "SUBJECT_WISE" }
  settings     Json            @default("{}")
  /// When this institution was suspended, or null while it is active.
  ///
  /// A timestamp rather than a boolean: "when did this stop" is the question
  /// asked during an incident, and a boolean cannot answer it. Nullable and
  /// null for every existing row — an institution created before this column
  /// existed is active, not in an unknown state.
  ///
  /// Suspension is a *platform* action (`platform.institution.suspend`) and is
  /// deliberately not a delete. Attendance records, audit history and
  /// enrolments all remain; what a suspension expresses is that the tenant
  /// should stop being served, which is reversible. Nothing cascades from it.
  suspendedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  campuses         Campus[]
  users            User[]
  students         Student[]
  academicUnits    AcademicUnit[]
  academicSessions AcademicSession[]
  subjects         Subject[]
  cohorts          Cohort[]
  roles            Role[]
  roleAssignments  UserRoleAssignment[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  auditLogs        AuditLog[]
  externalIdentities ExternalIdentity[]
}

// A physical branch/campus of an institution. Nullable everywhere it's
// referenced, so a single-campus institution is entirely unaffected — this
// is "Campus/Branch where required," not a mandatory extra hop.
model Campus {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  code          String
  address       String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  academicUnits   AcademicUnit[]
  users           User[]
  students        Student[]
  roleAssignments UserRoleAssignment[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model User {
  id            String        @id @default(cuid())
  // Nullable: null only for a platform-level user (holds a PLATFORM_SUPER_ADMIN
  // assignment, which is itself institutionId-less). Every other user must have
  // one — enforced in modules/auth-tenancy/service.ts, not by a DB constraint
  // Prisma can't express (conditional NOT NULL).
  institutionId String?
  institution   Institution?  @relation(fields: [institutionId], references: [id])
  campusId      String?
  campus        Campus?       @relation(fields: [campusId], references: [id])
  email         String        @unique
  name          String
  status        UserStatus    @default(ACTIVE)
  passwordHash  String?
  employeeCode  String?
  // The department a faculty member belongs to, at a college. Points at an
  // AcademicUnit rather than a new Department table for the reason the whole
  // school/college abstraction exists (see the note above AcademicUnit): a
  // department is already a node in that tree, and a parallel table would be
  // a second answer to "what departments does this institution have".
  //
  // Nullable and unenforced by kind at the database level — the service layer
  // (modules/faculty/directory-service.ts) is what refuses a unit that is not
  // a DEPARTMENT of this institution, because Prisma cannot express "FK, but
  // only to rows whose kind column says DEPARTMENT".
  departmentId  String?
  department    AcademicUnit? @relation(fields: [departmentId], references: [id])
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  roleAssignments UserRoleAssignment[]
  sessions        Session[]
  studentProfile  Student?
  facultyCohorts  CohortFaculty[]
  subjectLinks    CohortSubject[]
  openedSessions  AttendanceSession[]    @relation("SessionFaculty")
  corrections     AttendanceCorrection[] @relation("CorrectionActor")
  enrolledFaces   FaceEmbedding[]        @relation("FaceEnrolledBy")
  retiredFaces    FaceEmbedding[]        @relation("FaceRetiredBy")

  @@index([institutionId])
  @@index([campusId])
  // Postgres does not index a foreign key on its own, and the faculty
  // directory filters staff by department.
  @@index([departmentId])
}

// Server-side, revocable session (ADR-0007). tokenHash is HMAC-SHA256 of the
// random cookie value — the raw token is never stored, mirroring ApiKey.hashedKey.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// RBAC core (ADR-0006). Permission keys are a code-level catalog
// (modules/authorization/permissions.ts), validated in the service layer —
// RolePermission.permission is a plain string, not an FK to a Permission
// table, for the same reason Institution.settings is JSON-with-code-defaults
// rather than a schema fork: the catalog is a deploy-time fact, but which
// permissions a role grants is legitimately runtime-configurable.
// ---------------------------------------------------------------------------

model Role {
  id            String       @id @default(cuid())
  // null = platform-wide system role, seeded once, usable by every institution.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  key           String
  name          String
  isSystem      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([institutionId, key])
  @@index([institutionId])
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([roleId, permission])
  @@index([roleId])
}

model UserRoleAssignment {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role         @relation(fields: [roleId], references: [id])
  // null only alongside a PLATFORM_SUPER_ADMIN role assignment.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  // Narrows e.g. SCHOOL_ADMIN/COLLEGE_ADMIN to one campus; null = institution-wide.
  campusId      String?
  campus        Campus?      @relation(fields: [campusId], references: [id])
  createdAt     DateTime     @default(now())

  @@unique([userId, roleId, institutionId, campusId])
  @@index([userId])
  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Student {
  id              String           @id @default(cuid())
  institutionId   String
  institution     Institution      @relation(fields: [institutionId], references: [id])
  campusId        String?
  campus          Campus?          @relation(fields: [campusId], references: [id])
  // Optional link to a login-capable User (a STUDENT-role account) for a
  // future student portal. Nullable — most Student rows have no login yet.
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id])
  studentCode     String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  // Admission record. Distinct from `studentCode`, which is this system's
  // handle for the row: an admission number is the institution's own, issued
  // once at intake, and the two are the same string at some institutions and
  // unrelated at others. Deliberately NOT unique — a re-admission legitimately
  // reuses a number at some institutions, and a constraint that blocks a
  // clerk from recording what the register says is a constraint that gets
  // worked around with a fake value.
  admissionNumber String?
  admissionDate   DateTime?
  status          EnrollmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  enrollments        Enrollment[]
  subjectEnrollments StudentSubjectEnrollment[]
  faceEmbeddings     FaceEmbedding[]
  attendanceRecords  AttendanceRecord[]

  @@unique([institutionId, studentCode])
}

// ---------------------------------------------------------------------------
// School/college abstraction
//
// A school models: AcademicUnit(kind=GRADE) -> AcademicUnit(kind=SECTION, parent=grade) -> Cohort
// A college models: AcademicUnit(kind=DEPARTMENT) -> (kind=SEMESTER) -> (kind=COURSE) -> Cohort
// Same three tables (AcademicUnit, Cohort, Enrollment) serve both; institution-specific
// labels come from Institution.settings.academicUnitLabels, not from schema forks.
// ---------------------------------------------------------------------------

model AcademicUnit {
  id            String           @id @default(cuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id])
  campusId      String?
  campus        Campus?          @relation(fields: [campusId], references: [id])
  parentId      String?
  parent        AcademicUnit?    @relation("AcademicUnitTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      AcademicUnit[]   @relation("AcademicUnitTree")
  kind          AcademicUnitKind
  name          String
  code          String?
  sortOrder     Int              @default(0)
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now())

  cohorts        Cohort[]
  /**
   * Faculty whose department this unit is. Only ever set on a DEPARTMENT.
   */
  facultyMembers User[]

  @@index([institutionId])
  @@index([parentId])
}

// A named academic period (e.g. "2026-2027"), replacing what used to be a
// plain Cohort.academicYear string — needed as a first-class concept so
// sessions can be created/archived independently of any one Cohort.
model AcademicSession {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  startDate     DateTime
  endDate       DateTime
  // Not archived. A session stays active until somebody archives it, and it is
  // never deleted: Cohorts point at it and the attendance history under them
  // has to stay readable.
  isActive      Boolean     @default(true)
  // The academic year the institution is actually in right now — what a new
  // student is enrolled into and what a report means by "this year".
  //
  // Separate from `isActive` because an institution routinely has two sessions
  // that are both un-archived: the one running and the one it has already set
  // up for next year. Overloading `isActive` would make creating next year's
  // session in March silently move every default onto it.
  //
  // At most one per institution. Enforced in a transaction by
  // `setCurrentAcademicSessionForRequest`, not by the database: Prisma cannot
  // express a partial unique index (`UNIQUE (institutionId) WHERE isCurrent`),
  // and a plain unique index on (institutionId, isCurrent) would also forbid
  // the many rows that are legitimately false.
  isCurrent     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  cohorts Cohort[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

// The atomic, enrollable teaching group that attendance sessions are scoped to.
model Cohort {
  id                String          @id @default(cuid())
  institutionId     String
  institution       Institution     @relation(fields: [institutionId], references: [id])
  academicUnitId    String
  academicUnit      AcademicUnit    @relation(fields: [academicUnitId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  name              String
  termLabel         String?
  createdAt         DateTime        @default(now())

  enrollments  Enrollment[]
  subjects     CohortSubject[]
  sessions     AttendanceSession[]
  facultyLinks CohortFaculty[]

  @@index([institutionId])
  @@index([academicUnitId])
  @@index([academicSessionId])
}

model CohortFaculty {
  id       String            @id @default(cuid())
  cohortId String
  cohort   Cohort            @relation(fields: [cohortId], references: [id])
  userId   String
  user     User              @relation(fields: [userId], references: [id])
  role     CohortFacultyRole @default(PRIMARY)

  @@unique([cohortId, userId])
  // "Which classes do I teach?" — read on every faculty dashboard load
  // (attendance-analytics/repository.ts). The compound unique above leads with
  // cohortId, so it cannot answer a query filtered only by userId.
  @@index([userId])
}

// A subject/course offered within a cohort (college requirement: "subjects").
// Schema + types only this phase — no subject-management UI yet.
model Subject {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  code          String
  name          String
  createdAt     DateTime    @default(now())

  cohortLinks CohortSubject[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

// Which subjects a cohort offers, and who teaches each one — distinct from
// CohortFaculty's homeroom PRIMARY/ASSISTANT link. This is also the
// attendance-engine discriminator: an AttendanceSession referencing a
// CohortSubject is a college-style subject/lecture session; one with
// cohortSubjectId = null is a school-style daily/class session. One engine,
// one AttendanceSession table, branching on this field plus
// Institution.settings.attendanceMode — never two parallel models.
model CohortSubject {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  facultyId String?
  faculty   User?    @relation(fields: [facultyId], references: [id])
  createdAt DateTime @default(now())

  studentEnrollments StudentSubjectEnrollment[]
  attendanceSessions AttendanceSession[]

  @@unique([cohortId, subjectId])
  @@index([cohortId])
}

// Per-student subject enrollment (electives) — schema + types only this
// phase, no enrollment-management UI yet.
model StudentSubjectEnrollment {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  cohortSubjectId String
  cohortSubject   CohortSubject @relation(fields: [cohortSubjectId], references: [id])
  enrolledAt      DateTime      @default(now())

  @@unique([studentId, cohortSubjectId])
  // "Who is enrolled in this subject?" — subjects/repository.ts, and the
  // subject-scoped candidate loader in recognition-results/repository.ts joins
  // on this column. Not served by the compound unique, which leads with
  // studentId.
  @@index([cohortSubjectId])
}

model Enrollment {
  id            String           @id @default(cuid())
  institutionId String
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id])
  cohortId      String
  cohort        Cohort           @relation(fields: [cohortId], references: [id])
  status        EnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime         @default(now())
  unenrolledAt  DateTime?

  @@unique([studentId, cohortId])
  // "Which students are in this class?" — the roster read behind every capture
  // session (attendance-capture/service.ts counts ACTIVE rows) and the class
  // student list (enrollment/repository.ts). status is second so the same index
  // serves both the filtered count and the unfiltered listing.
  @@index([cohortId, status])
  // Institution-wide enrollment reads: the face-coverage report and the
  // /api/v1 enrollment listing, both of which scope by tenant first.
  @@index([institutionId, status])
}

// ---------------------------------------------------------------------------
// Attendance capture pipeline
// ---------------------------------------------------------------------------

model AttendanceSession {
  id              String         @id @default(cuid())
  institutionId   String
  cohortId        String
  cohort          Cohort         @relation(fields: [cohortId], references: [id])
  // null = school-style daily/class session; set = college-style
  // subject/lecture-specific session. See CohortSubject's doc comment.
  cohortSubjectId String?
  cohortSubject   CohortSubject? @relation(fields: [cohortSubjectId], references: [id])
  facultyId       String
  faculty         User           @relation("SessionFaculty", fields: [facultyId], references: [id])
  sessionDate     DateTime
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  status          SessionStatus  @default(OPEN)
  metadata        Json           @default("{}")

  images            SessionImage[]
  attendanceRecords AttendanceRecord[]

  // Every reporting query drives off exactly this shape:
  //   institutionId = ? AND status = 'FINALIZED' AND sessionDate >= ? AND < ?
  // (attendance-reporting/repository.ts, `sessionConditions`). It replaces a
  // bare institutionId index, which it still serves as a prefix — the
  // "sessions awaiting review" count filters on institutionId + status alone.
  @@index([institutionId, status, sessionDate])
  // The per-class equivalent: a cohort's sessions, newest first, or within a
  // date window. Replaces a bare cohortId index for the same prefix reason.
  @@index([cohortId, sessionDate])
  @@index([cohortSubjectId])
}

model SessionImage {
  id             String            @id @default(cuid())
  sessionId      String
  session        AttendanceSession @relation(fields: [sessionId], references: [id])
  sequenceNumber Int
  storageUrl     String
  qualityScore   Float?
  capturedAt     DateTime          @default(now())

  @@unique([sessionId, sequenceNumber])
}

// How the image that produced a template reached the server. Recorded because
// the two paths have different evidence behind them: a camera capture happened
// in front of whoever pressed the button, an upload is a file of unknown
// provenance. An investigation into a wrong template starts with this column.
enum FaceCaptureSource {
  CAMERA
  UPLOAD
}

// Who performed the enrollment. Staff-driven is the school workflow; self is
// the college one, and it is only reachable where the institution permits it
// (modules/face-enrollment/policy.ts).
enum FaceEnrollmentChannel {
  STAFF
  SELF
}

// Why a template stopped being used for recognition. A template is never
// deleted by these paths — it is retired, and the reason is the difference
// between "the student enrolled again" and "somebody asked us to stop".
enum FaceSampleRetirementReason {
  // Superseded by a newer template for the same student.
  REPLACED
  // An administrator removed this sample deliberately.
  WITHDRAWN
  // Removed by the retention sweep (modules/privacy).
  RETENTION
  // The student left, and the policy retires templates when they do.
  STUDENT_INACTIVE
}

// Stable contract row: whichever model produced this vector, dimension is
// fixed at 512 for this phase. See docs/adr/0005 for the model-swap contract.
//
// ## Why the provenance columns are nullable
//
// `weightsVersion`, `preprocessingVersion`, `aligned`, `qualityScore`,
// `captureSource` and `channel` describe how a template was made. Rows written
// before they existed cannot be given a truthful value, and a default would
// make every one of them assert something nobody checked. Null means "not
// recorded", which is the only honest answer, and the enrollment status
// (`modules/face-enrollment/status.ts`) reads it as a reason to re-enrol
// rather than as a fact about the capture.
model FaceEmbedding {
  id             String                     @id @default(cuid())
  institutionId  String
  studentId      String
  student        Student                    @relation(fields: [studentId], references: [id])
  // vector(128) — Unsupported so the Prisma Client doesn't attempt to type it;
  // populated/queried via $executeRaw / $queryRaw only.
  //
  // 128 is SFace's native output width, verified from the model graph in the
  // Phase 4.5 audit. It was vector(512) until Phase 5; that number was the
  // scaffold's placeholder, chosen before any model was. Widening 128 back up
  // to 512 by padding or random projection was rejected — it would add no
  // information and quadruple the cost of every comparison.
  //
  // The column width is the last line of defence against a mismatched vector:
  // Postgres rejects a wrong-length insert outright, which is why the
  // enrollment repository's own length check is a better error message rather
  // than the actual guarantee.
  //
  // Null for a gallery-backed sample (templateKind "gallery", e.g. Azure AI
  // Face): the template then lives at the provider, and where is recorded in
  // FaceGalleryPlacement. The pair is enforced by the CHECK constraint
  // "FaceEmbedding_template_present" in migration
  // 20260924120000_face_gallery_placement, not by Prisma.
  embedding      Unsupported("vector(128)")?
  modelName      String
  modelVersion   String
  // The two halves of `modelVersion`, stored separately as well as composed.
  // `modelVersion` is "<weights>+pp<preprocessing>" and is what decides which
  // vectors are comparable; these are what answer "which weights?" and "which
  // preprocessing?" without parsing a string that is not meant to be parsed.
  weightsVersion       String?
  preprocessingVersion String?
  // Recorded per row as well as fixed by the column, because a future model
  // swap changes the column for new rows while these rows still describe
  // vectors of the old width.
  embeddingDim   Int                        @default(128)
  // Whether the crop was a real landmark-driven alignment or a plain box crop.
  // A recognition model trained on aligned faces scores an unaligned crop
  // worse, so a template enrolled without alignment is a quieter problem than
  // one that failed outright — it simply never matches well.
  aligned        Boolean?
  // The quality score the model gave the accepted capture. Kept so a template
  // that was barely good enough can be found later, when somebody asks why one
  // student is never recognised.
  qualityScore   Float?
  captureSource  FaceCaptureSource?
  channel        FaceEnrollmentChannel?
  enrolledByUserId String?
  enrolledBy       User?   @relation("FaceEnrolledBy", fields: [enrolledByUserId], references: [id])
  // Never populated by the enrollment paths: the raw image is not persisted.
  // The column stays because the approved retention design may one day store a
  // reference under an explicit policy, and because removing it would rewrite
  // a table holding biometric data for no behavioural gain.
  sourceImageUrl String?
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  retiredAt        DateTime?
  retiredByUserId  String?
  retiredBy        User?                       @relation("FaceRetiredBy", fields: [retiredByUserId], references: [id])
  retirementReason FaceSampleRetirementReason?

  matchedRecords    AttendanceRecord[]     @relation("MatchedEmbedding")
  galleryPlacements FaceGalleryPlacement[]

  @@index([institutionId])
  @@index([studentId])
  // The duplicate scan asks for one institution's live templates and nothing
  // else; the history view asks for one student's, live and retired together.
  @@index([institutionId, isActive])
  @@index([studentId, isActive])
  // Postgres does not index a foreign key on its own.
  @@index([enrolledByUserId])
  @@index([retiredByUserId])
}

// Where one gallery-backed sample lives at the recognition provider.
//
// A gallery provider (Azure AI Face) keeps the template itself; this row is
// the pointer: one per (sample, class gallery). A student in two classes has
// the same photograph added to both galleries, so one FaceEmbedding row can
// own several placements. Ids only — nothing here is biometric on its own.
//
// Deleted when the provider-side face is deleted. A row whose sample is no
// longer active is a removal that has not succeeded yet, and the next
// retirement for the same student retries it.
model FaceGalleryPlacement {
  id              String        @id @default(cuid())
  institutionId   String
  faceEmbeddingId String
  faceEmbedding   FaceEmbedding @relation(fields: [faceEmbeddingId], references: [id], onDelete: Cascade)
  studentId       String
  cohortId        String
  galleryId       String
  personId        String
  persistedFaceId String
  createdAt       DateTime      @default(now())

  @@unique([galleryId, persistedFaceId])
  @@index([faceEmbeddingId])
  // Recognition resolves a class gallery's person ids back to students.
  @@index([galleryId, personId])
  @@index([studentId])
}

// aiResult/aiConfidence are advisory and written once by the recognition
// pipeline. finalResult is authoritative and faculty-owned; every mutation to
// it must also append an AttendanceCorrection row (enforced in the service
// layer, see apps/web/src/modules/attendance/service.ts).
model AttendanceRecord {
  id                  String            @id @default(cuid())
  institutionId       String
  sessionId           String
  session             AttendanceSession @relation(fields: [sessionId], references: [id])
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id])
  aiResult            AttendanceResult  @default(NOT_EVALUATED)
  aiConfidence        Float?
  matchedEmbeddingId  String?
  matchedEmbedding    FaceEmbedding?    @relation("MatchedEmbedding", fields: [matchedEmbeddingId], references: [id])
  finalResult         AttendanceResult  @default(NOT_EVALUATED)
  isManuallyCorrected Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  corrections AttendanceCorrection[]

  // Per-session reads use the compound unique's sessionId prefix.
  @@unique([sessionId, studentId])
  @@index([institutionId])
  // "Attendance by student" — a student's own history screen and the
  // studentIds filter on the reporting record list.
  @@index([studentId])
  // Not a read pattern: this is the referencing side of a SET NULL foreign key,
  // and the retention purge (privacy/repository.ts) deletes templates in
  // batches. Postgres does not index foreign keys automatically, so without
  // this every deleted embedding costs one sequential scan of this table.
  @@index([matchedEmbeddingId])
}

// Append-only audit trail. Rows are inserted, never updated or deleted.
model AttendanceCorrection {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id])
  previousResult     AttendanceResult
  newResult          AttendanceResult
  changedByUserId    String
  changedBy          User             @relation("CorrectionActor", fields: [changedByUserId], references: [id])
  reason             String?
  source             CorrectionSource
  changedAt          DateTime         @default(now())

  @@index([attendanceRecordId])
}

// ---------------------------------------------------------------------------
// Integration layer
// ---------------------------------------------------------------------------

/// What kind of internal record an external identifier points at.
///
/// Deliberately a small, closed list. An external system may hold ids for
/// anything, but this table only maps the entities the public API actually
/// exposes — adding a value here is a decision to support integrating that
/// entity, not a convenience.
enum ExternalEntityType {
  STUDENT
  FACULTY
  COHORT
  SUBJECT
}

/// A foreign system's identifier for something in this institution.
///
/// The problem it solves: an ERP calls a student `STU-10092`, this platform
/// calls them `cmu5dx…`, and neither is wrong. Before this table the importer
/// had nowhere to put the ERP's id except `Student.studentCode` — which is the
/// *institution's own* roll number, a different fact that the institution may
/// change and that a second integration would immediately contradict.
///
/// ## Why the unique keys are shaped this way
///
/// `(institutionId, provider, entityType, externalId)` is the collision guard
/// the whole design turns on. Two institutions using the same vendor will both
/// have a student `STU-10092`, and they are different people; including
/// `institutionId` in the key makes that representable rather than a clash.
/// Scoping by `provider` as well means an institution can run an ERP and an
/// LMS at once without their id spaces colliding.
///
/// `(institutionId, provider, entityType, internalId)` is the reverse: one
/// student has at most one id *per provider*. Without it a re-import under a
/// changed external id would silently accumulate mappings, and "which id does
/// the ERP know this student by" would have two answers.
///
/// ## Why `internalId` is a plain column and not a relation
///
/// It is polymorphic — a student, a cohort, a subject — and Prisma models no
/// polymorphic relation. The cost is no database-level referential integrity,
/// which is acceptable here because this platform deactivates rather than
/// deletes people and classes; a mapping is resolved through a service that
/// re-reads the target, so a dangling row surfaces as "not found" rather than
/// as corrupt data.
model ExternalIdentity {
  id            String             @id @default(cuid())
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id])
  /// The external system's name, as the integration administrator entered it.
  provider      String
  entityType    ExternalEntityType
  /// The identifier exactly as the external system spells it.
  externalId    String
  /// The `id` of the internal row, interpreted per `entityType`.
  internalId    String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([institutionId, provider, entityType, externalId])
  @@unique([institutionId, provider, entityType, internalId])
  // "Which external ids does this record have?" — the reverse lookup an
  // export needs when it has to label a row for the receiving system.
  @@index([institutionId, entityType, internalId])
}

model ApiKey {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  hashedKey     String      @unique
  scopes        String[]
  createdAt     DateTime    @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  /// When this key stops working, or null for a key with no expiry.
  ///
  /// Null rather than a default, deliberately. Every key issued before this
  /// column existed has no expiry and must keep working — silently expiring
  /// live integrations to tidy up a schema is an outage, not a hardening.
  /// New keys may set one; the API refuses an expired key exactly as it
  /// refuses a revoked one, and with the same 401, so neither tells a caller
  /// which of the two happened.
  expiresAt     DateTime?

  @@index([institutionId])
}

model WebhookEndpoint {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  url           String
  secret        String
  eventTypes    String[]
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([institutionId])
}

// Generic, cross-entity audit trail (ADR-0006). Distinct from
// AttendanceCorrection: this is a thin pointer usable for any entity type
// ("show me everything for institution X or actor Y"), not a replacement for
// the domain-rich, attendance-specific trail.
model AuditLog {
  id            String       @id @default(cuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  actorUserId   String?
  actorApiKeyId String?
  action        String
  entityType    String
  entityId      String
  beforeJson    Json?
  afterJson     Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())

  // The audit screen is always institution-scoped and always ordered
  // `createdAt DESC, id DESC` with skip/take (audit/repository.ts). Matching
  // the sort direction lets the paginated read walk the index instead of
  // sorting an institution's entire log to return twenty-five rows. Serves the
  // bare-institutionId lookups it replaces as a prefix.
  @@index([institutionId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

/// Token-bucket state for the public API rate limiter, shared across replicas.
///
/// Phase 15. The limiter counted in process memory, so behind the
/// `maxReplicas: 5` this app is already configured for, an API key received up
/// to five times its allowance and lost its counters on every restart. This
/// table is the shared state that fixes it.
///
/// Deliberately free-standing: no foreign key to Institution or ApiKey. The
/// key is an opaque string (`<apiKeyId>:<bucket>`) and a row is disposable
/// bookkeeping, not a record of anything. A cascade from ApiKey would put a
/// lock on the hot path of every request, and an orphaned row costs nothing
/// because it expires.
///
/// Rows are ephemeral. `expiresAt` is what makes a bucket forgettable: past
/// it, the bucket is indistinguishable from a full one, because an untouched
/// bucket refills to capacity anyway. Dropping this table loses nothing but
/// the current minute's counters.
model RateLimitBucket {
  /// `<apiKeyId>:<bucket>` — see `rateLimitKey()`. Opaque here on purpose.
  key       String   @id
  /// Fractional tokens remaining as of `updatedAt`. Fractional because refill
  /// is continuous; rounding here would quietly hand out free requests.
  tokens    Float
  updatedAt DateTime
  /// When this row stops meaning anything. Postgres has no row TTL, so the
  /// limiter treats an expired row as full and a sweep deletes it.
  expiresAt DateTime

  @@index([expiresAt])
}
