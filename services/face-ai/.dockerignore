# Build context for the Face AI image (context = services/face-ai).
.env
.env.*
**/.env
**/.env.*

.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
*.egg-info

# Tests and benchmarks run in CI, not in the production image. Leaving them out
# keeps the runtime surface to exactly the code that serves requests.
tests
bench
requirements-dev.txt
ruff.toml

# Model weights. The image fetches the recogniser itself, by checksum, in its
# own layer (see the Dockerfile) — so whatever a developer happens to have in
# models/ must not reach the build, or a local file could quietly become the
# shipped recogniser. Excluding them also keeps every build context small.
models

*.md
.DS_Store
