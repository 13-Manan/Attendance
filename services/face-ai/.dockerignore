# Build context for the Face AI image (context = services/face-ai).
.env
.env.*
**/.env
**/.env.*

.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
*.egg-info

# Tests and benchmarks run in CI, not in the production image. Leaving them out
# keeps the runtime surface to exactly the code that serves requests.
tests
bench
requirements-dev.txt
ruff.toml

# Model weights. ~37 MiB that the image deliberately does not carry — see the
# Dockerfile for why — and a build context is copied to the daemon wholesale,
# so excluding them keeps every build fast whether or not a developer has run
# scripts/fetch_models.py.
models

*.md
.DS_Store
